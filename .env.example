# Environment Variables for DocuMind AI
# Copy this file to .env and fill in your API key(s)

# Option 1: Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq API Key (Get free key from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
